  "components": {
    "schemas": {
      "Associacao": {
        "properties": {
          "id_contrato": {
            "type": "integer",
            "title": "Id Contrato"
          }
        },
        "type": "object",
        "required": [
          "id_contrato"
        ],
        "title": "Associacao"
      },
      "Bloqueio": {
        "properties": {
          "motivo_bloqueio": {
            "type": "string",
            "title": "Motivo Bloqueio"
          }
        },
        "type": "object",
        "required": [
          "motivo_bloqueio"
        ],
        "title": "Bloqueio"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NovaGarantia": {
        "properties": {
          "matricula_imovel": {
            "type": "string",
            "maxLength": 20,
            "title": "Matricula Imovel"
          },
          "valor_avaliacao": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 1000.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,16}0*$)\\d{0,13}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Valor Avaliacao"
          },
          "data_avaliacao": {
            "type": "string",
            "format": "date",
            "title": "Data Avaliacao"
          },
          "cpf_cnpj_proprietario": {
            "type": "string",
            "maxLength": 14,
            "title": "Cpf Cnpj Proprietario"
          }
        },
        "type": "object",
        "required": [
          "matricula_imovel",
          "valor_avaliacao",
          "data_avaliacao",
          "cpf_cnpj_proprietario"
        ],
        "title": "NovaGarantia"
      },
      "NovoContrato": {
        "properties": {
          "numero": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Numero"
          },
          "cpf_cnpj_cliente": {
            "type": "string",
            "maxLength": 14,
            "title": "Cpf Cnpj Cliente"
          },
          "valor": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,16}0*$)\\d{0,13}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Valor"
          }
        },
        "type": "object",
        "required": [
          "numero",
          "cpf_cnpj_cliente",
          "valor"
        ],
        "title": "NovoContrato"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
